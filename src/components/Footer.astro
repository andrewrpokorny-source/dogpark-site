---
import { Image } from 'astro:assets';
import logo from '../assets/logo-lime.webp';
import Icon from './Icon.astro';
---
<footer class="relative mt-24 bg-ink text-cream">
  <!-- grass edge -->
  <div class="grass-edge !mb-0" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr] lg:px-8">
    <div>
      <Image src={logo} alt="Dog Park: A Get Lost! Game" width={360} class="h-14 w-auto rounded-lg" />
      <p class="mt-5 max-w-sm text-cream/70">
        A family-friendly labyrinth board game, enjoyed by families everywhere. Created by Brenda Pokorny.
      </p>
      <p class="eyebrow mt-6 text-lime">Patent pending</p>
    </div>
    <div>
      <h3 class="eyebrow mb-4 text-cream/50">Explore</h3>
      <ul class="-my-2 grid grid-cols-2 gap-x-6 font-display">
        {[
          ['/how-to-play', 'How to Play'], ['/play', 'Play'], ['/products-store', 'Store'],
          ['/about', 'About'], ['/contact', 'Contact'], ['/notify-me', 'Notify Me'],
        ].map(([href, label]) => (
          <li><a class="inline-flex min-h-11 items-center hover:text-lime" href={href}>{label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="eyebrow mb-4 text-cream/50">Say hi</h3>
      <ul class="-my-2 text-cream/80">
        <li class="flex min-h-11 items-center gap-3"><Icon name="mail" class="size-5 text-lime" /><a class="inline-flex min-h-11 items-center hover:text-lime" href="mailto:help@dogparkgames.com">help@dogparkgames.com</a></li>
        <li class="flex min-h-11 items-center gap-3"><Icon name="pin" class="size-5 text-lime" />Mooresville, North Carolina</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cream/10">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-6 text-sm text-cream/50 sm:flex-row sm:px-6 lg:px-8">
      <p>© {new Date().getFullYear()} Dog Park Games. All rights reserved.</p>
      <p class="flex items-center gap-2">Made with <Icon name="heart" class="size-4 text-coral" /> and a lot of paws</p>
    </div>
  </div>
</footer>
