---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import board from '../assets/game-board.webp';
import group from '../assets/pups-group.webp';

// Everything named in the rules on /how-to-play
const contents = [
  'Labyrinth game board',
  'Dog playing pieces',
  'Die',
  'PAW cards',
  'DOGGY DOOR cards',
  'QUESTION cards',
  'Bone, diamond & heart tokens',
];
---
<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-labelledby="game-title">
  <article class="reveal relative grid overflow-hidden rounded-[2rem] border-4 border-ink bg-ink text-cream lg:grid-cols-[1.05fr_0.95fr]">
    <!-- Art -->
    <div class="relative bg-lime-soft p-6 pt-10 sm:p-10">
      <div class="relative mx-auto max-w-[520px]">
        <div class="absolute inset-4 rotate-3 rounded-[1.5rem] bg-ink/90" aria-hidden="true"></div>
        <Image src={board} alt="The Dog Park game board" width={1100} class="relative w-full -rotate-2 rounded-[1.5rem] border-4 border-ink shadow-2xl" loading="eager" />

        <!-- Coming soon sticker -->
        <div class="sticker absolute -right-3 -top-6 size-32 sm:-right-8 sm:-top-8 sm:size-40" role="img" aria-label="Coming soon">
          <svg viewBox="0 0 200 200" class="size-full drop-shadow-[0_6px_0_var(--color-ink)]" aria-hidden="true">
            <polygon fill="var(--color-token-red)" stroke="var(--color-ink)" stroke-width="5" stroke-linejoin="round"
              points="100,4 116,30 145,16 150,48 182,46 172,77 198,94 172,113 184,143 152,145 148,177 118,165 100,194 82,165 52,177 48,145 16,143 28,113 2,94 28,77 18,46 50,48 55,16 84,30" />
            <circle cx="100" cy="100" r="64" fill="none" stroke="var(--color-cream)" stroke-width="2.5" stroke-dasharray="5 6" />
            <g fill="var(--color-cream)" font-family="var(--font-display)" font-weight="800" text-anchor="middle">
              <text x="100" y="94" font-size="24" textLength="86" lengthAdjust="spacingAndGlyphs">COMING</text>
              <text x="100" y="126" font-size="32" textLength="90" lengthAdjust="spacingAndGlyphs">SOON!</text>
            </g>
          </svg>
        </div>

        <Image src={group} alt="The six Dog Park playing pieces" width={600}
          class="absolute -bottom-6 -left-3 w-40 rotate-[-6deg] rounded-xl border-4 border-ink bg-white shadow-[0_5px_0_var(--color-ink)] sm:-left-8 sm:w-56" />
      </div>
    </div>

    <!-- Details -->
    <div class="flex flex-col p-6 pt-12 sm:p-10 lg:pt-10">
      <p class="eyebrow inline-flex items-center gap-2 self-start rounded-full bg-cream/10 px-3 py-1.5 text-lime">
        <span class="size-2 animate-pulse rounded-full bg-token-red"></span> The main event
      </p>
      <h2 id="game-title" class="mt-5 text-4xl font-extrabold leading-[1] sm:text-5xl">Dog Park: A Get Lost! Game</h2>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <span class="rounded-full border-2 border-cream/25 px-4 py-1.5 font-display font-semibold">Price TBA</span>
        <span class="text-sm text-cream/60">Pre-orders open mid-November</span>
      </div>
      <p class="mt-6 text-lg leading-relaxed text-cream/80">
        Move your dog token through the labyrinth, collecting bones, diamonds, and hearts along the path. But don’t get
        sent to the dog house… Family-friendly board game fun for all ages.
      </p>

      <h3 class="eyebrow mt-8 text-cream/50">What you’ll play with</h3>
      <ul class="mt-3 grid gap-x-6 gap-y-2 text-cream/85 sm:grid-cols-2">
        {contents.map((c) => (
          <li class="flex items-center gap-2.5 text-[15px]"><Icon name="paw" class="size-4 shrink-0 -rotate-12 text-lime" />{c}</li>
        ))}
      </ul>

      <div class="mt-auto flex flex-col gap-3 pt-10 sm:flex-row">
        <a href="/notify-me" class="btn btn-primary flex-1">Notify me when it’s ready <Icon name="arrow" class="size-5" /></a>
        <a href="/how-to-play" class="btn btn-ghost">How to play</a>
      </div>
      <p class="mt-4 flex items-center gap-2 text-sm text-cream/50"><Icon name="check" class="size-4 text-lime" /> Patent pending</p>
    </div>
  </article>
</section>

<style>
  .sticker { transform: rotate(12deg); animation: sticker-wiggle 4s ease-in-out infinite; }
  @keyframes sticker-wiggle {
    0%, 82%, 100% { transform: rotate(12deg) scale(1); }
    86% { transform: rotate(4deg) scale(1.06); }
    90% { transform: rotate(18deg) scale(1.06); }
    94% { transform: rotate(10deg) scale(1); }
  }
  /* Hover: the sticker lifts off the board like it's about to peel */
  .sticker { transition: transform .35s cubic-bezier(.2, .7, .2, 1); cursor: default; }
  .sticker svg { transition: filter .35s ease; }
  .sticker:hover { animation: none; transform: perspective(500px) translateY(-16px) rotate(2deg) rotateX(26deg) rotateY(-20deg) scale(1.14); }
  .sticker:hover svg { filter: drop-shadow(10px 26px 2px rgb(29 34 24 / 0.32)); }
  @media (prefers-reduced-motion: reduce) { .sticker { animation: none; } }
</style>
