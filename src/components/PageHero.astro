---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}
const { eyebrow, title, lede } = Astro.props;
---
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute -right-32 -top-48 size-[520px] rounded-full bg-lime/35 blur-3xl" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 pb-10 pt-10 sm:px-6 md:pb-14 md:pt-16 lg:px-8">
    <p class="reveal eyebrow text-lime-deep">{eyebrow}</p>
    <h1 class="reveal mt-4 max-w-3xl text-[clamp(2.5rem,6.5vw,4.5rem)] font-extrabold leading-[1]" data-delay="1">{title}</h1>
    {lede && <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft sm:text-xl" data-delay="2">{lede}</p>}
    <slot />
  </div>
</section>
