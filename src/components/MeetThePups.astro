---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { pups, pupName } from '../data/pups';
---
<section class="lawn py-16 md:py-20" aria-labelledby="pups-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="eyebrow text-lime-deep">Meet the pups</p>
        <h2 id="pups-title" class="mt-3 text-4xl font-bold sm:text-5xl">Six dogs. One winding path.</h2>
      </div>
      <a href="/play" class="btn btn-dark self-start md:self-auto"><Icon name="dice" class="size-5" /> Play a sample round</a>
    </div>
  </div>

  <!-- Swipeable on phones, grid on desktop -->
  <ul class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-6 [scrollbar-width:none] sm:px-6 lg:mx-auto lg:grid lg:max-w-7xl lg:grid-cols-3 xl:grid-cols-6 lg:overflow-visible lg:px-8">
    {pups.map((p, i) => (
      <li class="reveal w-[68%] shrink-0 snap-center sm:w-[40%] lg:w-auto" data-delay={String((i % 3) + 1)}>
        <a href={`/play?pup=${p.id}`} class="pup-card group flex h-full flex-col overflow-hidden rounded-3xl border-2 border-ink bg-white shadow-[0_4px_0_var(--color-ink)] transition duration-300 hover:-translate-y-1.5 hover:shadow-[0_8px_0_var(--color-ink)]" style={`--pup:${p.hex}`}>
          <div class="relative aspect-square overflow-hidden bg-white lg:aspect-[4/3] xl:aspect-square">
            <Image src={p.image} alt={`The ${p.color.toLowerCase()} ${p.breed} playing piece`} width={600} class="absolute inset-0 size-full origin-[50%_93%] object-contain transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-3" />
            <span class="absolute left-3 top-3 rounded-full border-2 border-ink bg-cream px-2.5 py-0.5 font-type text-[11px] font-bold">No. {i + 1}</span>
          </div>
          <div class="flex flex-1 flex-col p-4 xl:px-3.5">
            <h3 class="whitespace-nowrap font-display text-lg font-bold leading-tight tracking-tight xl:text-base">{pupName(p)}</h3>
            <p class="mt-2 text-sm leading-snug text-ink-soft">{p.blurb}</p>
            <p class="mt-auto flex items-center gap-1 pt-3 font-display text-sm font-semibold">
              <span class="underline decoration-[var(--pup)] decoration-[3px] underline-offset-4">Play as this pup</span> <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-1" />
            </p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
