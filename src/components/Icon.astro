---
interface Props {
  name: 'bone' | 'diamond' | 'heart' | 'paw' | 'cart' | 'menu' | 'close' | 'arrow' | 'mail' | 'pin' | 'check' | 'dice';
  class?: string;
}
const { name, class: cls = 'size-6' } = Astro.props;
---
{name === 'bone' && (
  <svg class={cls} viewBox="0 0 64 64" aria-hidden="true"><g fill="currentColor" transform="rotate(-35 32 32)"><rect x="14" y="26" width="36" height="12" rx="4"/><circle cx="13" cy="25" r="7.5"/><circle cx="13" cy="39" r="7.5"/><circle cx="51" cy="25" r="7.5"/><circle cx="51" cy="39" r="7.5"/></g></svg>
)}
{name === 'diamond' && (
  <svg class={cls} viewBox="0 0 64 64" aria-hidden="true"><path fill="currentColor" d="M18 8h28l14 16-28 34L4 24 18 8Z"/><path fill="#fff" opacity=".35" d="M18 8h14l-8 16H4L18 8Z"/></svg>
)}
{name === 'heart' && (
  <svg class={cls} viewBox="0 0 64 64" aria-hidden="true"><path fill="currentColor" d="M32 58S4 41 4 21A13 13 0 0 1 32 13a13 13 0 0 1 28 8c0 20-28 37-28 37Z"/></svg>
)}
{name === 'paw' && (
  <svg class={cls} viewBox="0 0 64 64" aria-hidden="true"><g fill="currentColor"><ellipse cx="32" cy="44" rx="14" ry="12"/><ellipse cx="14" cy="28" rx="6" ry="8" transform="rotate(-20 14 28)"/><ellipse cx="25" cy="16" rx="6" ry="8"/><ellipse cx="39" cy="16" rx="6" ry="8"/><ellipse cx="50" cy="28" rx="6" ry="8" transform="rotate(20 50 28)"/></g></svg>
)}
{name === 'cart' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20.5" r="1.2"/><circle cx="17" cy="20.5" r="1.2"/></svg>
)}
{name === 'menu' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
)}
{name === 'close' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
)}
{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
)}
{name === 'mail' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg>
)}
{name === 'pin' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
)}
{name === 'check' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
)}
{name === 'dice' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4"/><g fill="currentColor" stroke="none"><circle cx="8.5" cy="8.5" r="1.5"/><circle cx="15.5" cy="8.5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="8.5" cy="15.5" r="1.5"/><circle cx="15.5" cy="15.5" r="1.5"/></g></svg>
)}
