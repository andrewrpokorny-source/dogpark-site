---
import { toyFair } from '../data/events';
---
<div id="announce" class="relative z-[51] hidden bg-ink text-cream" data-end={toyFair.end}>
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-3 px-12 py-2.5 text-center text-sm">
    <span class="hidden size-2 shrink-0 animate-pulse rounded-full bg-lime sm:inline-block" aria-hidden="true"></span>
    <p>
      <span class="font-display font-semibold">Visit Dog Park at {toyFair.name}{toyFair.booth && <>, Booth #{toyFair.booth}</>}</span>
      <span class="text-cream/70"> · {toyFair.dates}, New York.</span>
      <a href="/#toy-fair" class="ml-1 whitespace-nowrap font-semibold text-lime underline underline-offset-4 hover:text-cream">Details →</a>
    </p>
  </div>
  <button type="button" data-dismiss class="absolute right-2 top-1/2 grid size-8 -translate-y-1/2 place-items-center rounded-full text-cream/60 hover:bg-cream/10 hover:text-cream" aria-label="Dismiss announcement">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
</div>

<script>
  const bar = document.getElementById('announce')!;
  const KEY = 'dogpark-announce-toyfair-2027';
  const over = new Date(`${bar.dataset.end}T23:59:59-05:00`) < new Date();
  let dismissed = false;
  try { dismissed = localStorage.getItem(KEY) === '1'; } catch { /* storage blocked */ }
  if (!over && !dismissed) bar.classList.remove('hidden');
  bar.querySelector('[data-dismiss]')!.addEventListener('click', () => {
    bar.classList.add('hidden');
    try { localStorage.setItem(KEY, '1'); } catch { /* storage blocked */ }
  });
</script>
