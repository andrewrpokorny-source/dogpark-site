---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = 'Dog Park: A Get Lost! Game. Move your dog through the labyrinth collecting bones, diamonds and hearts. A family-friendly board game for all ages.',
} = Astro.props;
const fullTitle = title ? `${title} · Dog Park` : 'Dog Park · A Get Lost! Game';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b4cb76" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Link previews (iMessage, Facebook, Slack, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dog Park: A Get Lost! Game" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dog Park: A Get Lost! Game, with the illustrated labyrinth game board" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{fullTitle}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-cream">Skip to content</a>
    <AnnouncementBar />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <div id="toast" role="status" aria-live="polite" class="pointer-events-none fixed inset-x-0 bottom-6 z-[70] flex justify-center px-4 opacity-0 translate-y-4 transition-all duration-300">
      <div class="flex items-center gap-3 rounded-full bg-ink px-5 py-3 font-display text-sm text-cream shadow-2xl">
        <span class="grid size-6 place-items-center rounded-full bg-lime text-ink">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
        </span>
        <span data-toast-text>Added!</span>
      </div>
    </div>

    <div class="paw-trail" aria-hidden="true">
      {Array.from({ length: 14 }, () => (
        <svg viewBox="0 0 64 64"><g fill="currentColor"><ellipse cx="32" cy="44" rx="14" ry="12"/><ellipse cx="14" cy="28" rx="6" ry="8" transform="rotate(-20 14 28)"/><ellipse cx="25" cy="16" rx="6" ry="8"/><ellipse cx="39" cy="16" rx="6" ry="8"/><ellipse cx="50" cy="28" rx="6" ry="8" transform="rotate(20 50 28)"/></g></svg>
      ))}
    </div>

    <script>
      import { cartCount } from '../lib/cart';
      import { loadKlaviyo } from '../lib/klaviyo';

      // Klaviyo onsite tracking: page activity, and recognizing people who click through from emails
      loadKlaviyo();

      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Images fade and sharpen in as they load. Layered art ([data-fade-group]) waits for every layer.
      if (!calm) {
        const reveal = (imgs: HTMLImageElement[]) => {
          imgs.forEach((i) => i.classList.add('img-in'));
          requestAnimationFrame(() => requestAnimationFrame(() => imgs.forEach((i) => i.classList.remove('img-pending'))));
        };
        const groups = new Map<Element, HTMLImageElement[]>();
        document.querySelectorAll<HTMLImageElement>('main img').forEach((img) => {
          const g = img.closest('[data-fade-group]') ?? img;
          groups.set(g, [...(groups.get(g) ?? []), img]);
        });
        groups.forEach((imgs) => {
          const waiting = imgs.filter((i) => !i.complete);
          if (!waiting.length) return;
          imgs.forEach((i) => i.classList.add('img-pending'));
          let left = waiting.length;
          waiting.forEach((i) => {
            const done = () => { if (--left === 0) reveal(imgs); };
            i.addEventListener('load', done, { once: true });
            i.addEventListener('error', done, { once: true });
          });
        });
      }

      // Paw-print stamp where a button is pressed
      if (!calm) {
        const PAW = document.querySelector('.paw-trail svg')!.innerHTML;
        document.addEventListener('pointerdown', (e) => {
          if (!(e.target as Element).closest?.('.btn')) return;
          const s = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          s.setAttribute('viewBox', '0 0 64 64');
          s.setAttribute('class', 'paw-stamp');
          s.setAttribute('aria-hidden', 'true');
          s.innerHTML = PAW;
          s.style.left = `${e.clientX}px`;
          s.style.top = `${e.clientY}px`;
          s.style.setProperty('--r', `${Math.round(Math.random() * 50 - 25)}deg`);
          document.body.append(s);
          s.addEventListener('animationend', () => s.remove());
        });
      }

      // Paw-print trail fills in as you scroll
      {
        const trail = document.querySelector<HTMLElement>('.paw-trail')!;
        const paws = [...trail.querySelectorAll('svg')];
        const paint = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          trail.style.visibility = max < 500 ? 'hidden' : '';
          const p = max > 0 ? scrollY / max : 0;
          paws.forEach((paw, i) => paw.classList.toggle('on', p >= i / (paws.length - 1) - 0.001 && p > 0.01));
        };
        paint();
        addEventListener('scroll', paint, { passive: true });
        addEventListener('resize', paint);
      }

      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Cart badge
      const paintCount = () => {
        const n = cartCount();
        document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((b) => {
          b.textContent = String(n);
          b.classList.toggle('hidden', n === 0);
        });
      };
      paintCount();
      window.addEventListener('cart:change', paintCount);

      // Toast
      const toast = document.getElementById('toast')!;
      let t: number | undefined;
      window.addEventListener('toast', (e) => {
        toast.querySelector('[data-toast-text]')!.textContent = (e as CustomEvent<string>).detail;
        toast.classList.remove('opacity-0', 'translate-y-4');
        clearTimeout(t);
        t = window.setTimeout(() => toast.classList.add('opacity-0', 'translate-y-4'), 2600);
      });
    </script>
  </body>
</html>
