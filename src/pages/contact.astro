---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import dogHouse from '../assets/dog-house.webp';
---
<Layout title="Contact" description="Questions about Dog Park: A Get Lost! Game or our merchandise? Get in touch.">
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -left-40 top-10 size-[520px] rounded-full bg-lime/35 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl gap-12 px-4 py-10 sm:px-6 md:py-16 lg:grid-cols-[0.9fr_1.1fr] lg:px-8">
      <div>
        <p class="reveal eyebrow text-lime-deep">Contact us</p>
        <h1 class="reveal mt-4 text-[clamp(2.5rem,6.5vw,4.5rem)] font-extrabold leading-[1]" data-delay="1">Throw us a bone.</h1>
        <p class="reveal mt-6 max-w-md text-lg leading-relaxed text-ink-soft sm:text-xl" data-delay="2">
          Contact us with questions regarding the game, or any of our merchandise.
        </p>

        <ul class="reveal mt-10 space-y-4" data-delay="3">
          <li>
            <a href="mailto:help@dogparkgames.com" class="group flex items-center gap-4">
              <span class="grid size-12 place-items-center rounded-2xl bg-lime transition group-hover:rotate-[-8deg]"><Icon name="mail" class="size-6" /></span>
              <span>
                <span class="block text-sm text-ink-soft">Email</span>
                <span class="font-display font-semibold group-hover:underline">help@dogparkgames.com</span>
              </span>
            </a>
          </li>
          <li class="flex items-center gap-4">
            <span class="grid size-12 place-items-center rounded-2xl bg-butter"><Icon name="pin" class="size-6" /></span>
            <span>
              <span class="block text-sm text-ink-soft">Home base</span>
              <span class="font-display font-semibold">Mooresville, North Carolina</span>
            </span>
          </li>
        </ul>

        <div class="reveal mt-12 hidden max-w-xs lg:block" data-delay="3">
          <Image src={dogHouse} alt="The pink Dog House, with a terrier sitting in the doorway" width={600} class="w-full rotate-[-3deg] rounded-3xl border-4 border-ink shadow-[0_6px_0_var(--color-ink)]" />
        </div>
      </div>

      <form id="contact-form" class="reveal card h-fit p-6 sm:p-10" data-delay="2" novalidate>
        <div data-form-body class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="label" for="c-first">First name</label>
            <input class="field" id="c-first" name="first" autocomplete="given-name" />
          </div>
          <div>
            <label class="label" for="c-last">Last name</label>
            <input class="field" id="c-last" name="last" autocomplete="family-name" />
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="c-email">Email <span class="text-token-red">*</span></label>
            <input class="field" id="c-email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="c-topic">What’s this about?</label>
            <select class="field appearance-none bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%231d2218%22 stroke-width=%222.5%22><path d=%22m6 9 6 6 6-6%22/></svg>')] bg-[length:20px] bg-[right_1rem_center] bg-no-repeat pr-12" id="c-topic" name="topic">
              <option>The game</option>
              <option>Merchandise</option>
              <option>Something else</option>
              <option>Just saying hi</option>
            </select>
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="c-msg">Message <span class="text-token-red">*</span></label>
            <textarea class="field min-h-36 resize-y" id="c-msg" name="message" required></textarea>
          </div>
          <p data-error class="hidden text-sm font-semibold text-token-red sm:col-span-2">Please add your email and a message.</p>
          <button class="btn btn-dark sm:col-span-2" type="submit">Send message <Icon name="arrow" class="size-5" /></button>
        </div>
        <div data-success class="hidden py-10 text-center">
          <div class="mx-auto grid size-20 place-items-center rounded-full bg-lime"><Icon name="check" class="size-10" /></div>
          <h2 class="mt-6 text-3xl font-bold">Message fetched!</h2>
          <p class="mt-3 text-ink-soft">Thanks for reaching out. We’ll get back to you soon.</p>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.querySelector<HTMLInputElement>('#c-email')!;
    const msg = form.querySelector<HTMLTextAreaElement>('#c-msg')!;
    const ok = email.value && email.checkValidity() && msg.value.trim();
    form.querySelector('[data-error]')!.classList.toggle('hidden', !!ok);
    if (!ok) return;
    form.querySelector('[data-form-body]')!.classList.add('hidden');
    form.querySelector('[data-success]')!.classList.remove('hidden');
  });
</script>
