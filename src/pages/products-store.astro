---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import GameFeature from '../components/GameFeature.astro';
import { products } from '../data/products';

// Pre-render thumbnails used by the cart and color swatches
const thumbs = Object.fromEntries(
  await Promise.all(products.map(async (p) => [p.id, (await getImage({ src: p.gallery[0].src, width: 200, format: 'webp' })).src])),
);
const optionImages = await Promise.all(
  products.map((p) => Promise.all(p.options.map(async (o) => (o.image ? (await getImage({ src: o.image, width: 1000, format: 'webp' })).src : null)))),
);
---
<Layout title="Store" description="Dog Park: A Get Lost! Game (coming soon), plus car magnets and long-sleeve logo tees.">
  <PageHero
    eyebrow="The Dog Park shop"
    title="The Dog Park store."
    lede="The game is almost here. While you wait for it to be released, share your Dog Park spirit with goodies featuring our signature Welsh Terrier."
  />

  <GameFeature />

  <section class="mx-auto max-w-7xl px-4 pb-8 pt-20 sm:px-6 md:pt-24 lg:px-8">
    <p class="reveal eyebrow text-lime-deep">While you wait</p>
    <h2 class="reveal mt-3 text-3xl font-bold sm:text-4xl" data-delay="1">Merch for the whole pack.</h2>
  </section>

  <section class="mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:px-8">
    {products.map((p, pi) => (
      <article class="reveal card grid overflow-hidden lg:grid-cols-2" data-product={p.id} data-name={p.name} data-price={p.price} data-thumb={thumbs[p.id]}>
        <!-- Gallery -->
        <div class="min-w-0 bg-lime-soft p-4 sm:p-6">
          <div class="relative aspect-square overflow-hidden rounded-2xl bg-white">
            {p.gallery.map((g, i) => (
              <Image src={g.src} alt={g.alt} width={1000} data-slide={i} class:list={['absolute inset-0 size-full object-cover transition-opacity duration-500', i !== 0 && 'opacity-0']} />
            ))}
            <img data-option-preview alt="" class="absolute inset-0 size-full bg-white object-contain p-6 opacity-0 transition-opacity duration-500" />
          </div>
          <div class="mt-4 flex gap-3 overflow-x-auto pb-1">
            {p.gallery.map((g, i) => (
              <button type="button" data-thumb-btn={i} aria-label={`Show photo ${i + 1}`} class:list={['size-16 shrink-0 overflow-hidden rounded-xl border-2 transition sm:size-20', i === 0 ? 'border-ink' : 'border-transparent opacity-70 hover:opacity-100']}>
                <Image src={g.src} alt="" width={160} class="size-full object-cover" />
              </button>
            ))}
          </div>
        </div>

        <!-- Details -->
        <div class="flex min-w-0 flex-col p-6 sm:p-10">
          <p class="eyebrow text-lime-deep">{p.tagline}</p>
          <h2 class="mt-3 text-3xl font-bold sm:text-4xl">{p.name}</h2>
          <p class="mt-3 font-display text-2xl font-semibold">
            {p.priceFrom && <span class="text-base font-normal text-ink-soft">from </span>}${p.price.toFixed(2)}
          </p>
          <p class="mt-5 leading-relaxed text-ink-soft">{p.description}</p>

          <fieldset class="mt-8">
            <legend class="label">{p.optionLabel}: <span data-option-label class="font-normal text-ink-soft">{p.options[0].label}</span></legend>
            <div class="mt-2 flex flex-wrap gap-2.5">
              {p.options.map((o, i) => o.swatch ? (
                <button type="button" data-option={o.label} data-option-img={optionImages[pi][i]} data-photo={o.photo ? '' : undefined} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={o.label} title={o.label}
                  class="size-11 rounded-full border-2 border-ink/20 ring-offset-2 ring-offset-white transition hover:scale-110 aria-pressed:border-ink aria-pressed:ring-2 aria-pressed:ring-ink"
                  style={`background:${o.swatch}`}></button>
              ) : (
                <button type="button" data-option={o.label} aria-pressed={i === 0 ? 'true' : 'false'}
                  class="min-w-14 rounded-full border-2 border-ink/15 bg-white px-4 py-2.5 font-display text-sm font-semibold transition hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-cream">{o.label}</button>
              ))}
            </div>
          </fieldset>

          <div class="mt-auto flex flex-col gap-3 pt-10 sm:flex-row">
            <button type="button" data-add class="btn btn-dark flex-1"><Icon name="cart" class="size-5" /> Add to cart</button>
            <a href="/cart" class="btn btn-ghost">View cart</a>
          </div>
        </div>
      </article>
    ))}
  </section>
</Layout>

<script>
  import { addToCart, toast } from '../lib/cart';

  document.querySelectorAll<HTMLElement>('[data-product]').forEach((card) => {
    const slides = card.querySelectorAll<HTMLElement>('[data-slide]');
    const thumbBtns = card.querySelectorAll<HTMLButtonElement>('[data-thumb-btn]');
    const preview = card.querySelector<HTMLImageElement>('[data-option-preview]')!;
    const optionBtns = card.querySelectorAll<HTMLButtonElement>('[data-option]');
    const optionLabel = card.querySelector('[data-option-label]')!;

    const showSlide = (n: number) => {
      preview.classList.add('opacity-0');
      slides.forEach((s, i) => s.classList.toggle('opacity-0', i !== n));
      thumbBtns.forEach((b, i) => {
        b.classList.toggle('border-ink', i === n);
        b.classList.toggle('border-transparent', i !== n);
        b.classList.toggle('opacity-70', i !== n);
      });
    };
    thumbBtns.forEach((b, i) => b.addEventListener('click', () => showSlide(i)));

    optionBtns.forEach((b) =>
      b.addEventListener('click', () => {
        optionBtns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
        optionLabel.textContent = b.dataset.option!;
        if (b.dataset.optionImg) {
          preview.src = b.dataset.optionImg;
          const photo = 'photo' in b.dataset;
          preview.classList.toggle('object-cover', photo);
          preview.classList.toggle('object-contain', !photo);
          preview.classList.toggle('p-6', !photo);
          preview.alt = `${card.dataset.name} in ${b.dataset.option}`;
          preview.classList.remove('opacity-0');
        }
      }),
    );

    card.querySelector('[data-add]')!.addEventListener('click', () => {
      const option = card.querySelector<HTMLButtonElement>('[data-option][aria-pressed="true"]')!.dataset.option!;
      addToCart({
        id: card.dataset.product!,
        name: card.dataset.name!,
        option,
        price: Number(card.dataset.price),
        image: card.dataset.thumb!,
      });
      toast(`${card.dataset.name} (${option}) added to cart`);
    });
  });
</script>
