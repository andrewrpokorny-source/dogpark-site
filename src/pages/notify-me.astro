---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import parkSign from '../assets/dog-park-sign.webp';
---
<Layout title="Notify Me" description="Be first to know when Dog Park: A Get Lost! Game is available.">
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -left-40 top-20 size-[520px] rounded-full bg-lime/35 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-10 sm:px-6 md:py-16 lg:grid-cols-2 lg:px-8">
      <div>
        <p class="reveal eyebrow text-lime-deep">Pre-orders open mid-November</p>
        <h1 class="reveal mt-4 text-[clamp(2.5rem,6.5vw,4.5rem)] font-extrabold leading-[1]" data-delay="1">Be first to get the game.</h1>
        <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-ink-soft sm:text-xl" data-delay="2">
          Add yourself to our list. You’ll be the first to find out when the game is available. Plus be first to find out
          when new merch and expansion packs come out!
        </p>

        <form id="notify-form" class="reveal card mt-10 p-6 sm:p-8" data-delay="3" novalidate>
          <div data-form-body class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="label" for="first">First name</label>
              <input class="field" id="first" name="first" autocomplete="given-name" placeholder="Brenda" />
            </div>
            <div>
              <label class="label" for="last">Last name</label>
              <input class="field" id="last" name="last" autocomplete="family-name" placeholder="Pokorny" />
            </div>
            <div class="sm:col-span-2">
              <label class="label" for="email">Email <span class="text-token-red">*</span></label>
              <input class="field" id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
              <p data-error class="mt-2 hidden text-sm font-semibold text-token-red">Please enter a valid email so we can reach you.</p>
            </div>
            <label class="flex items-start gap-3 text-sm text-ink-soft sm:col-span-2">
              <input type="checkbox" name="merch" checked class="mt-0.5 size-5 shrink-0 accent-lime-deep" />
              Also tell me about new merch and expansion packs.
            </label>
            <button class="btn btn-dark sm:col-span-2" type="submit">Add me to the list <Icon name="paw" class="size-5" /></button>
          </div>

          <div data-success class="hidden py-6 text-center">
            <div class="mx-auto grid size-20 place-items-center rounded-full bg-lime">
              <Icon name="paw" class="size-10 -rotate-12" />
            </div>
            <h2 class="mt-6 text-3xl font-bold">You’re on the list!</h2>
            <p class="mt-3 text-ink-soft">Good dog. We’ll be in touch the moment pre-orders open.</p>
          </div>
        </form>
      </div>

      <div class="reveal relative" data-delay="2">
        <div class="absolute -inset-3 -rotate-2 rounded-[2rem] bg-ink" aria-hidden="true"></div>
        <Image src={parkSign} alt="A terrier looks up at a wooden Dog Park sign on a grassy field" width={1400} class="relative w-full rounded-[1.75rem] border-4 border-ink" loading="eager" />
        <div class="absolute -bottom-6 left-6 rotate-[-4deg] rounded-2xl border-2 border-ink bg-butter px-5 py-3 shadow-[0_4px_0_var(--color-ink)]">
          <p class="eyebrow text-[10px]">No spam. Just bones.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('notify-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = form.querySelector<HTMLInputElement>('#email')!;
    const err = form.querySelector('[data-error]')!;
    if (!email.checkValidity() || !email.value) {
      err.classList.remove('hidden');
      email.focus();
      return;
    }
    err.classList.add('hidden');
    form.querySelector('[data-form-body]')!.classList.add('hidden');
    form.querySelector('[data-success]')!.classList.remove('hidden');
  });
</script>
