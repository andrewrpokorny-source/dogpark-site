---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import board from '../assets/game-board.webp';
import { pups, pupName } from '../data/pups';

const pupThumbs = await Promise.all(pups.map(async (p) => (await getImage({ src: p.image, width: 160, height: 160, fit: 'cover', format: 'webp' })).src));
const tokenRows = [
  { id: 'bone', label: 'Bones', icon: 'bone', color: 'text-terrier', bar: 'bg-terrier' },
  { id: 'diamond', label: 'Diamonds', icon: 'diamond', color: 'text-periwinkle', bar: 'bg-periwinkle' },
  { id: 'heart', label: 'Hearts', icon: 'heart', color: 'text-token-red', bar: 'bg-token-red' },
] as const;
---
<Layout title="Play a sample round" description="Roll the die and walk your pup through Brenda's labyrinth in a sample round of Dog Park: A Get Lost! Game.">
  <div class="lawn pb-16">
  <section class="mx-auto max-w-7xl px-4 pb-6 pt-8 sm:px-6 md:pt-12 lg:px-8">
    <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <div>
        <p class="eyebrow text-lime-deep">Sample round</p>
        <h1 class="mt-3 text-[clamp(2.25rem,5.5vw,4rem)] font-extrabold leading-[1]">Take your pup for a spin.</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-soft">Roll the die and wander Brenda’s labyrinth. Collect 5 bones, 5 diamonds, and 5 hearts, then race to TOP DOG.</p>
      </div>
      <a href="/how-to-play" class="font-display text-sm font-semibold underline decoration-lime decoration-2 underline-offset-4">Full rules →</a>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:px-8" data-game>
    <!-- Board -->
    <div class="lg:sticky lg:top-24 lg:self-start">
      <div class="relative overflow-hidden rounded-[1.75rem] border-4 border-ink bg-ink shadow-2xl">
        <div class="relative">
          <Image src={board} alt="The Dog Park game board" width={1400} class="block w-full select-none" draggable="false" loading="eager" />
          <span data-ring class="pointer-events-none absolute size-[6.5%] -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-white/90 shadow-[0_0_0_3px_rgb(29_34_24/0.5)] transition-[left,top] duration-200" style="left:50%;top:92%"></span>
          <div data-token class="token absolute z-10 size-[7%] -translate-x-1/2 -translate-y-[62%] transition-[left,top] ease-out" style="left:50%;top:92%">
            <img data-token-img alt="Your dog token" class="size-full rounded-full border-[3px] border-[var(--pup,#78be20)] bg-white object-cover shadow-[0_4px_0_var(--color-ink)]" />
          </div>
          <div data-confetti class="pointer-events-none absolute inset-0 overflow-hidden"></div>
        </div>
        <div class="flex items-center gap-3 bg-ink px-4 py-3 text-cream">
          <span class="eyebrow text-[10px] text-cream/60">Start</span>
          <div class="h-2 flex-1 overflow-hidden rounded-full bg-cream/15"><div data-progress class="h-full rounded-full bg-lime transition-[width] duration-300" style="width:0%"></div></div>
          <span class="eyebrow text-[10px] text-cream/60">Top dog</span>
        </div>
      </div>
    </div>

    <!-- Panel -->
    <div class="space-y-4">
      <!-- Roll -->
      <div class="card p-5">
        <div class="flex items-center gap-4">
          <div data-die class="grid size-16 shrink-0 grid-cols-3 grid-rows-3 rounded-2xl border-[3px] border-ink bg-white p-2 shadow-[0_4px_0_var(--color-ink)] sm:size-[4.5rem]" role="img" aria-label="Die"></div>
          <button type="button" data-primary class="btn btn-dark flex-1 !py-4 text-lg">Roll the die</button>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" data-play-dp class="rounded-full border-2 border-ink/15 bg-white px-3.5 py-2 font-display text-sm font-semibold transition enabled:hover:border-ink disabled:opacity-45">🌳 Play DOG PARK card × <span>1</span></button>
          <button type="button" data-play-choice hidden class="rounded-full border-2 border-ink/15 bg-white px-3.5 py-2 font-display text-sm font-semibold transition enabled:hover:border-ink disabled:opacity-45">🎁 Play CHOICE × <span>0</span></button>
          <button type="button" data-redeem-door hidden class="rounded-full border-2 border-ink/15 bg-white px-3.5 py-2 font-display text-sm font-semibold transition enabled:hover:border-ink disabled:opacity-45">🚪 Redeem DOGGY DOOR <span></span></button>
        </div>
        <label class="mt-4 flex cursor-pointer items-center gap-3 text-sm text-ink-soft">
          <input type="checkbox" data-zoomies checked class="peer sr-only" />
          <span class="relative h-6 w-11 shrink-0 rounded-full bg-ink/15 transition after:absolute after:left-0.5 after:top-0.5 after:size-5 after:rounded-full after:bg-white after:shadow after:transition peer-checked:bg-lime-deep peer-checked:after:translate-x-5 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-token-red"></span>
          <span><strong class="text-ink">Zoomies mode</strong>: move twice as far for a quicker round</span>
        </label>
      </div>

      <!-- Dog Park trading -->
      <div data-park hidden class="card border-lime-deep/40 bg-lime-soft p-5">
        <p class="eyebrow text-lime-deep">You’re in the Dog Park</p>
        <p class="mt-1 text-sm text-ink-soft" data-park-note>1 trade per turn, made before you roll.</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" data-trade="warden" class="btn btn-primary !px-4 !py-2 text-sm disabled:opacity-45">Dog Warden 2:1</button>
          <button type="button" data-trade="door" class="btn btn-ghost !px-4 !py-2 text-sm disabled:opacity-45">DOGGY DOOR</button>
          <button type="button" data-stay class="btn btn-ghost !px-4 !py-2 text-sm disabled:opacity-45">Stay (end turn)</button>
        </div>
      </div>

      <!-- Event -->
      <div class="card p-5" aria-live="polite">
        <div data-event></div>
      </div>

      <!-- Pup + stats -->
      <div class="card p-5">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="eyebrow text-[11px] text-ink-soft">Playing as</p>
            <p class="font-display text-xl font-bold" data-pup-name>Green Pup</p>
          </div>
          <div class="text-right">
            <p class="eyebrow text-[11px] text-ink-soft">Turn</p>
            <p class="font-display text-xl font-bold" data-turn>1</p>
          </div>
        </div>
        <div class="mt-4 flex gap-2 overflow-x-auto pb-1" role="group" aria-label="Choose your pup">
          {pups.map((p, i) => (
            <button type="button" data-pup={p.id} data-img={pupThumbs[i]} data-hex={p.hex} data-name={pupName(p)} aria-label={pupName(p)} aria-pressed="false"
              class="size-12 shrink-0 overflow-hidden rounded-full border-[3px] border-transparent bg-white transition hover:scale-105 aria-pressed:border-ink aria-pressed:shadow-[0_0_0_3px_var(--color-lime)]">
              <img src={pupThumbs[i]} alt="" class="size-full object-cover" />
            </button>
          ))}
        </div>

        <div class="mt-5 grid grid-cols-3 gap-2">
          {tokenRows.map((t) => (
            <div class="token-stat rounded-2xl border-2 border-ink/10 bg-cream p-3 transition-colors">
              <div class="flex items-center justify-between">
                <Icon name={t.icon} class={`size-6 ${t.color}`} />
                <p class="font-display text-2xl font-extrabold leading-none"><span data-count={t.id} class="inline-block">0</span><span class="text-sm font-semibold text-ink-soft">/5</span></p>
              </div>
              <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-ink/10"><div data-bar={t.id} class={`h-full rounded-full ${t.bar} transition-[width] duration-300`} style="width:0%"></div></div>
              <p class="mt-1.5 text-[11px] font-semibold text-ink-soft">{t.label}</p>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-ink-soft"><span data-total>0</span> tokens collected</p>
      </div>

      <!-- Log -->
      <div class="card p-5">
        <div class="flex items-center justify-between">
          <p class="eyebrow text-[11px] text-ink-soft">Game log</p>
          <button type="button" data-new class="font-display text-sm font-semibold underline decoration-lime decoration-2 underline-offset-4">New game</button>
        </div>
        <ul data-log class="mt-2 divide-y divide-ink/5 text-sm"></ul>
      </div>

      <p class="px-1 text-xs leading-relaxed text-ink-soft">
        This is a solo sample round. PAW cards and trivia questions are samples, and trading with other dogs, STEAL cards, and the
        Dog Warden’s limited supply are left out. See the <a href="/how-to-play" class="underline">full rules</a> for the real thing.
      </p>
    </div>
  </section>
  </div>
</Layout>

<style>
  .token-stat.is-full { background: var(--color-lime-soft); border-color: var(--color-lime-deep); }
</style>

<script>
  import { initGame } from '../scripts/game';
  const root = document.querySelector<HTMLElement>('[data-game]');
  if (root) initGame(root);
</script>
